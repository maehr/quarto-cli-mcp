{
	"name": "quarto-cli-mcp",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A thin MCP server that wraps the Quarto CLI.",
	"license": "AGPL-3.0-only",
	"author": {
		"name": "Moritz Mähr",
		"email": "moritz.maehr@gmail.com",
		"url": "https://github.com/maehr"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/maehr/quarto-cli-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/maehr/quarto-cli-mcp/issues"
	},
	"homepage": "https://github.com/maehr/quarto-cli-mcp#readme",
	"keywords": [
		"mcp",
		"quarto",
		"model-context-protocol"
	],
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"quarto-cli-mcp": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --coverage",
		"check": "pnpm run lint && pnpm run typecheck && pnpm run test",
		"start": "node dist/index.js",
		"changelog": "git-cliff -o CHANGELOG.md",
		"prepare": "simple-git-hooks"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.0",
		"pino": "10.3.1",
		"yaml": "2.9.0",
		"zod": "4.5.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@types/node": "26.4.0",
		"@vitest/coverage-v8": "4.1.11",
		"git-cliff": "2.13.1",
		"simple-git-hooks": "2.14.0",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"simple-git-hooks": {
		"commit-msg": "pnpm exec commitlint --edit \"$1\"",
		"pre-push": "pnpm run check"
	}
}
